{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "description": "Release build with MSVC on Windows",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JUCE_DIR": "JUCE"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "description": "Debug build with MSVC on Windows",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JUCE_DIR": "JUCE"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "release-tests",
      "configurePreset": "windows-msvc-release",
      "configuration": "Release",
      "output": {"outputOnFailure": true}
    },
    {
      "name": "debug-tests",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {"outputOnFailure": true}
    }
  ]
}